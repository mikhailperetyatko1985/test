APP_NAME="MastApp Test Task"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

CACHE_STORE=memcached
# Сервис memcached из docker-compose.yml (внутренняя сеть compose)
MEMCACHED_HOST=memcached
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

REFERRAL_PERCENT=10
REFERRAL_PER_PAGE=50

# Порт на хосте для docker-compose.yml (внутри контейнера всегда 8000)
HOST_PORT=8001
